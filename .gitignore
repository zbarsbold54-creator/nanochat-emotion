.venv/
__pycache__/
*.pyc
dev-ignore/
report.md
eval_bundle/
base_checkpoints/

# Generated training/eval artifacts. These are reproducible outputs, not
# source: kept on disk, excluded from git.
logs/
eval/eval_anomaly_set.jsonl
eval/recall_comparison.json

# Local run driver. Regenerated per sweep and specific to one machine's GPU
# timing, so it is a working script rather than source.
run_sweep.ps1

# Secrets
.env

# Local setup
CLAUDE.md
wandb/

# Obsidian (the research/ folder is edited as an Obsidian vault). The config
# and workspace state are per-machine and per-user -- they record window
# positions, pane layout and plugin choices, which are noise in a repo and
# cause merge conflicts on every layout change.
.obsidian/

# Obsidian scratch artifacts. Created empty by Obsidian when a vault is opened,
# so they carry no content worth versioning:
#   Untitled.canvas          -- an empty canvas
#   YYYY-MM-DD.md            -- an empty daily note for the day the vault opened
# Real research notes in research/ are tracked normally; only these generated
# placeholders are excluded. If a daily note ever contains real writing,
# delete its line here and it will be tracked from then on.
research/Untitled.canvas
research/2026-10-01.md
