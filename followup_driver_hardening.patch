--- a/scripts/driver_retry.py (conceptual)
+++ b/scripts/driver_retry.py
@@ -1,3 +1,15 @@
+# (a) checkpoint complete only if all float tensors finite
+def checkpoint_complete(model, optim):
+    for t in model.state_dict().values():
+        if isinstance(t, torch.Tensor) and t.dtype.is_floating_point and not torch.isfinite(t).all(): return False
+    for g in optim.param_groups:
+        for p in g['params']:
+            if p.grad is not None and not torch.isfinite(p.grad).all(): return False
+    for s in optim.state.values():
+        for v in s.values():
+            if isinstance(v, torch.Tensor) and v.dtype.is_floating_point and not torch.isfinite(v).all(): return False
+    return True
+# (b) stop retry if same step fails with no newer checkpoint
+# (c) save rolling latest 2 every 100 iterations
